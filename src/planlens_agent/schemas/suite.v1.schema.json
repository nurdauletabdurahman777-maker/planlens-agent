{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planlens-agent/suite/v1",
  "title": "A set of candidate plans to run together",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "contract",
    "catalog",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "planlens-agent/suite/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "description": {
      "type": "string"
    },
    "contract": {
      "type": "string"
    },
    "catalog": {
      "type": "string"
    },
    "plans_dir": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "plan"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "sample": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "plan": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
