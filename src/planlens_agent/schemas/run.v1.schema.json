{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planlens-agent/run/v1",
  "title": "A saved suite run. A record, not an approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_schema",
    "report_schema",
    "engine",
    "runtime",
    "rules",
    "suite",
    "plans_dir",
    "policy",
    "labels",
    "labels_note",
    "status",
    "exit_code",
    "summary",
    "suite_errors",
    "cases",
    "note"
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "path",
        "step_id",
        "step_index",
        "source_span"
      ],
      "properties": {
        "document": {
          "enum": [
            "plan",
            "contract",
            "catalog"
          ]
        },
        "path": {
          "type": "string"
        },
        "step_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "step_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_span": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_version",
        "category",
        "title",
        "message",
        "observed",
        "required",
        "location",
        "location_absent_reason",
        "related_locations",
        "contract_rule",
        "explanation",
        "suggestion",
        "evidence"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "integer"
        },
        "category": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "observed": {},
        "required": {},
        "location": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/location"
            }
          ]
        },
        "location_absent_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "contract_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  },
  "properties": {
    "run_schema": {
      "const": "planlens-agent/run/v1"
    },
    "report_schema": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "evaluator_sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "evaluator_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python"
      ],
      "properties": {
        "python": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "plans_dir": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "catalog"
      ],
      "properties": {
        "contract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "catalog": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "labels_note": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "rejected",
        "incomplete"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "passed",
        "rejected",
        "incomplete",
        "suite_errors",
        "findings"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "suite_errors": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "suite_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "path"
        ],
        "properties": {
          "code": {
            "enum": [
              "invalid-case",
              "duplicate-case"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "sample",
          "plan",
          "verdict",
          "exit_code",
          "error_kind",
          "plan_evaluated",
          "findings"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "sample": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "steps",
              "canonical"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "steps": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "canonical": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "verdict": {
            "enum": [
              "pass",
              "reject",
              "error"
            ]
          },
          "exit_code": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "error_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan_evaluated": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          }
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
