{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planlens-agent/catalog/v1",
  "title": "planlens-agent action catalog, v1",
  "description": "Owner-supplied. Lists the actions a plan may use and the artifact inputs/outputs each declares. All declared inputs are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "planlens-agent/catalog/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 500,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "inputs": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            }
          },
          "outputs": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            }
          }
        }
      }
    }
  }
}
