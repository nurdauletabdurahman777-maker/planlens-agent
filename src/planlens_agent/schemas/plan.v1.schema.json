{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planlens-agent/plan/v1",
  "title": "planlens-agent candidate plan, v1",
  "description": "Untrusted, agent-proposed. List order is execution order. Step ids must be unique (checked by the engine; not expressible here). Fields that try to change policy are reported by the engine as violations; fields asking for unsupported semantics are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "planlens-agent/plan/v1"
    },
    "title": {
      "type": "string",
      "maxLength": 2000
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "mode": {
      "const": "sequential"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "action": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "inputs": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
            }
          }
        }
      }
    }
  }
}
